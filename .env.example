NODE_ENV=development
LOG_LEVEL=info
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=32123
BRIDGE_AUTH_TOKEN=replace-with-at-least-32-random-characters
COMMAND_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=5000
MAX_QUEUE_SIZE=100
MAX_PAYLOAD_BYTES=262144
RATE_LIMIT_PER_MINUTE=120
SAFE_MODE=true
ALLOWED_MEDIA_DIRECTORIES=C:\Media
ALLOWED_EXPORT_DIRECTORIES=C:\Exports
BACKUP_DIRECTORY=C:\PremiereBackups
CONFIRMATION_TOKEN_TTL_MS=60000
PREMIERE_MOCK=false
