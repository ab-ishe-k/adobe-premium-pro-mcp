{
  "name": "premiere-pro-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tsc -b && npm run build:plugin",
    "build:server": "tsc -b apps/mcp-server",
    "build:plugin": "node scripts/build-plugin.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "start": "node apps/mcp-server/dist/index.js",
    "watch": "tsc -b --watch",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run apps/mcp-server/tests/server.integration.test.ts",
    "test:all": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "diagnostics": "node apps/mcp-server/dist/index.js --diagnostics"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.2.1",
    "pino": "^9.7.0",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
